{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@ai-pass/auth-core/server": ["./packages/auth-core/src/server/index.ts"],
      "@ai-pass/auth-core": ["./packages/auth-core/src/index.ts"],
      "@ai-pass/*": ["./packages/*/src/index.ts"]
    }
  }
}
